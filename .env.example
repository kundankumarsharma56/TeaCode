# Copy to .env and fill in. NEVER commit .env. Every value below is a placeholder.
# Docker Compose reads this file; for `mvn spring-boot:run` export the same names in your shell.

# ---- Database (MySQL 8.4) -------------------------------------------------------------
MYSQL_DATABASE=codevibs
MYSQL_USER=codevibs
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# ---- Backend core ---------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
# Production: the public https:// origin users type in the browser (the prod profile refuses http://).
# Local HTTP testing: use docker-compose.dev.yml, which switches to the dev profile.
APP_PUBLIC_URL=https://codevibs.example.invalid
# At least 32 random characters, for example:  openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=codevibs
# Generate a separate random 32+ character token shared only by backend and terminal-runner.
TERMINAL_RUNNER_INTERNAL_TOKEN=replace-with-a-random-32-plus-character-secret

# ---- JDoodle Compiler API (code execution). Server-side only: never put these in VITE_* ---
# Create credentials at https://www.jdoodle.com/compiler-api . Without both values, running code is disabled
# and the language list is empty (nothing is faked).
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=
# Optional: comma separated language keys to switch off, e.g. swift,rust
JDOODLE_DISABLED_LANGUAGES=

# ---- Authorized problem packages (admin-free import) ----------------------------------
# Folder INSIDE the backend container that is scanned for *.zip packages. Compose mounts ./problem-packages here.
# Leave empty to disable the importer.
PROBLEM_PACKAGES_DIR=/data/problem-packages
PROBLEM_PACKAGES_AUTO_PUBLISH=true

# ---- Optional sign-in providers (a provider is enabled only when both values are set) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Email (verification and password reset) ------------------------------------------
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ---- Public, build-time values shown on the legal and contact pages. Never secrets. ------
# Anything left empty is displayed on the page as an explicit "operator to provide" gap.
VITE_LEGAL_ENTITY_NAME=
VITE_LEGAL_ADDRESS=
VITE_PRIVACY_CONTACT_EMAIL=
VITE_SUPPORT_EMAIL=
VITE_HOSTING_PROVIDER=
VITE_EMAIL_PROVIDER=
VITE_RETENTION_NOTE=

# ---- Sign-in: Firebase Authentication, passwordless email link (see docs/firebase-setup.md) ----
# Public web-app identifiers from Firebase console > Project settings > Your apps. Not secrets. Without them sign-in is disabled.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Sandbox image store volume. Create once: docker volume create teacode_sandbox-images
# SANDBOX_IMAGES_VOLUME=teacode_sandbox-images
